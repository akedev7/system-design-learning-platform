# Auth0 Configuration
# Get these values from your Auth0 dashboard (https://manage.auth0.com/)

# Auth0 Issuer URI (e.g., https://your-tenant.auth0.com/)
AUTH0_ISSUER_URI=https://your-tenant.auth0.com/

# Auth0 API Audience (optional, for Spring Boot resource server)
AUTH0_AUDIENCE=https://localhost:8080

# Auth0 Secret (for Next.js Auth0 session encryption)
# Generate with: openssl rand -hex 32
AUTH0_SECRET=your-32-byte-secret-here-change-me

# Auth0 Application Base URL
AUTH0_BASE_URL=http://localhost:3000

# Auth0 Client ID (from Auth0 Application settings)
AUTH0_CLIENT_ID=your-client-id-here

# Auth0 Client Secret (from Auth0 Application settings)
AUTH0_CLIENT_SECRET=your-client-secret-here

# Database Configuration (defaults shown, change for production)
# POSTGRES_DB=courses
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
