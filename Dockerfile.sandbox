# Docker Sandbox for AI Agent
# Provides isolated environment with Java/Maven for Spring Boot services

FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    build-essential \
    ca-certificates \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# Install Java 17 JDK
RUN apt-get update && apt-get install -y \
    openjdk-17-jdk \
    && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH=$JAVA_HOME/bin:$PATH

# Install Maven
RUN wget https://archive.apache.org/dist/maven/maven-3/3.9.6/binaries/apache-maven-3.9.6-bin.tar.gz \
    && tar -C /opt -xzf apache-maven-3.9.6-bin.tar.gz \
    && rm apache-maven-3.9.6-bin.tar.gz \
    && ln -s /opt/apache-maven-3.9.6 /opt/maven
ENV MAVEN_HOME=/opt/maven
ENV PATH=$MAVEN_HOME/bin:$PATH

# Install go-task (for task runner support)
RUN curl -sL https://taskfile.dev/install.sh | sh -s -- -b /usr/local/bin

# Create working directory
WORKDIR /workspace

# Copy sandbox setup script
COPY scripts/setup-sandbox.sh /usr/local/bin/setup-sandbox.sh
RUN chmod +x /usr/local/bin/setup-sandbox.sh

# Default command
CMD ["/bin/bash"]
