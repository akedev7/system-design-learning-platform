FROM node:20-alpine

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy package.json and lock file
COPY package.json pnpm-lock.yaml* ./

# Install dependencies
RUN pnpm install

# Copy source code (for hot-reload via volume mount)
COPY . .

EXPOSE 3000

# Use turbopack for faster development
CMD ["pnpm", "dev"]
