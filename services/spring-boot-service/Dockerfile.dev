FROM maven:3.9-eclipse-temurin-17

WORKDIR /app

# Copy pom.xml first for better layer caching
COPY pom.xml .

# Download dependencies
RUN mvn dependency:go-offline -B

# Copy source code
COPY src ./src

EXPOSE 8080

# Run with spring-boot:run for hot-reload capability
# Using -Dspring-boot.run.fork=false to allow hot-reload
CMD ["mvn", "spring-boot:run", "-Dspring-boot.run.fork=false", "-Dspring-boot.run.jvmArguments=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005"]
